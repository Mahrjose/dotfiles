##########################################################################
# Automatically Generated Git Configuration File
# 
# Please do not edit this file directly. Use the 'switch-git' script to 
# manage and switch between profiles.
# 
# Last generated on: Fri Apr 17 11:30:16 PM +06 2026
##########################################################################

[user]
    email = mirzamahrabhossain@gmail.com
    name = Mirza Mahrab Hossain
    signingkey = CD18429D8834DF0F

[core]
    editor = subl -n -w
    compression = 5
    autocrlf = input # Linux : "input" | Windows : "true"
    safecrlf = true

[credential]
    helper = store

[commit]
    gpgsign = true

[tag]
    gpgSign = true

[init]
    defaultBranch = main

[color]
    ui = auto

[pull]
    rebase = false

[fetch]
    unpackLimit = 1

[http]
    postBuffer = 1048576000
    retry = 1000
    retryDelay = 5
    maxRequests = 10
    lowSpeedLimit = 350
    lowSpeedTime = 600

[url "https://"]
    insteadOf = git://

[alias]
    st = status
    cm = commit
    co = checkout
    br = branch
    lg = log --oneline --graph --decorate --color --all --abbrev-commit --date=short

[help]
    autocorrect = 1
