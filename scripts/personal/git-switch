#!/bin/env bash
# git-switch: switch between personal and office git profiles
# Secrets are fetched from Bitwarden at runtime - run `bw unlock` first

GITCONFIG="$HOME/.gitconfig"
GITCREDENTIALS="$HOME/.git-credentials"

PERSONAL_EMAIL="mirzamahrabhossain@gmail.com"
PERSONAL_SIGNING_KEY="CD18429D8834DF0F"
PERSONAL_BW_NAME="GitHub Token Personal (mahrjose)"

OFFICE_EMAIL="mm.hossain@ppln.co"
OFFICE_SIGNING_KEY="8DC5609278B16186"
OFFICE_BW_NAME="GitHub Token Office (mahrab-ppln)"

PERSONAL_GH_USER="mahrjose"
OFFICE_GH_USER="mahrab-ppln"

bw_get_token() {
    local item_name="$1"
    local token=""

    if [[ -z "${BW_SESSION:-}" ]]; then
        local session_file="$HOME/.cache/bw_session"
        if [[ -f "$session_file" ]]; then
            export BW_SESSION="$(cat "$session_file")"
        else
            echo "Bitwarden locked. Run 'bw-unlock' first."
            exit 1
        fi
    fi

    local raw
    raw=$(node --no-deprecation /usr/bin/bw get item "$item_name" 2>/dev/null)
    token=$(echo "$raw" | jq -r '.notes // empty' | tr -d '[:space:]')

    if [[ -z "$token" ]]; then
        echo "Error: could not fetch '$item_name' from Bitwarden vault." >&2
        exit 1
    fi

    echo "$token"
}

generate_gitconfig() {
    local email="$1"
    local signing_key="$2"

    cat <<EOF
##########################################################################
# Automatically Generated Git Configuration File
#
# Please do not edit this file directly. Use the 'git-switch' script to
# manage and switch between profiles.
#
# Last generated on: $(date)
##########################################################################

[user]
    email = $email
    name = Mirza Mahrab Hossain
    signingkey = $signing_key

[core]
    editor = subl -n -w
    compression = 5
    autocrlf = input
    safecrlf = true

[credential]
    helper = store

[commit]
    gpgsign = true

[tag]
    gpgSign = true

[init]
    defaultBranch = main

[color]
    ui = auto

[pull]
    rebase = false

[fetch]
    unpackLimit = 1

[http]
    postBuffer = 1048576000
    retry = 1000
    retryDelay = 5
    maxRequests = 10
    lowSpeedLimit = 350
    lowSpeedTime = 600

[url "https://"]
    insteadOf = git://

[alias]
    st = status
    cm = commit
    co = checkout
    br = branch
    lg = log --oneline --graph --decorate --color --all --abbrev-commit --date=short

[help]
    autocorrect = 1
EOF
}

switch_profile() {
    local profile="$1"
    local email signing_key bw_name gh_user token credentials

    if [[ "$profile" == "office" ]]; then
        email="$OFFICE_EMAIL"
        signing_key="$OFFICE_SIGNING_KEY"
        bw_name="$OFFICE_BW_NAME"
        gh_user="$OFFICE_GH_USER"
    elif [[ "$profile" == "personal" ]]; then
        email="$PERSONAL_EMAIL"
        signing_key="$PERSONAL_SIGNING_KEY"
        bw_name="$PERSONAL_BW_NAME"
        gh_user="$PERSONAL_GH_USER"
    else
        echo "Invalid option! Use --office or --personal"
        exit 1
    fi

    echo "Fetching token from Bitwarden..."
    token=$(bw_get_token "$bw_name")
    credentials="https://${gh_user}:${token}@github.com"

    generate_gitconfig "$email" "$signing_key" > "$GITCONFIG"
    echo "$credentials" > "$GITCREDENTIALS"

    echo "$token" | gh auth login --with-token

    if gh auth status &>/dev/null; then
        echo "Switched git and gh CLI to $profile ($email)"
    else
        echo "Git switched to $profile, but gh CLI authentication failed."
    fi
}

setup_git() {
    if [[ -f "$GITCONFIG" || -f "$GITCREDENTIALS" ]]; then
        echo "Git configuration files already exist."
        read -rp "Overwrite? (y/n): " choice
        [[ "$choice" != "y" ]] && echo "Aborted." && exit 0
    fi
    echo "Setting up personal git profile by default..."
    switch_profile "personal"
}

case "$1" in
    -o | --office)   switch_profile "office" ;;
    -p | --personal) switch_profile "personal" ;;
    -s | --setup)    setup_git ;;
    *)
        echo "Usage: git-switch --office | --personal | --setup"
        exit 1
        ;;
esac
